# Anistroph environment configuration
# Copy this file to .env and adjust as needed.
# All values are optional — the application has sensible defaults.

# --- Dataset partitioning defaults ---
# Fractions of the full dataset, must sum to 1.0.
# Per-dataset YAML split: sections override these values.
TRAIN_DATASET_PCT=0.80
EVAL_DATASET_PCT=0.20
# Reserved for future validation-during-training partition.
VALIDATE_DATASET_PCT=0.0

# --- ngrok (optional, for ChatGPT GPT Actions via make start-gpt) ---
# Get a free token at https://dashboard.ngrok.com/get-started/your-authtoken
# NGROK_AUTHTOKEN=your-ngrok-authtoken-here
